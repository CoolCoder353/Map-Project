# Copy to infra/.env and fill in. Never commit the real file.
SITE_ADDRESS=maps.example.com
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=change-me-long-random
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me
GRAPHHOPPER_HEAP=8g
GRAPHHOPPER_IMPORT_HEAP=12g
PLANETILER_HEAP=8g
# Monthly OSM refresh (cron, UTC). Empty disables the schedule.
OSM_REFRESH_CRON=0 3 2 * *
LOG_LEVEL=info

# Behind a proxy that terminates HTTPS (the small-server profile, docker-compose.small.yml):
# SITE_ADDRESS=http://:8080
# HTTP_PORT=8080
# PUBLIC_URL=https://maps.your-group.org
# Every setting is described in docs/configuration.md.
