{
  "name": "@wayfinder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": { "development": "./src/app.ts", "default": "./dist/app.js" }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx --conditions=development src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@wayfinder/core": "workspace:*",
    "@wayfinder/shared": "workspace:*",
    "fastify": "^5.12.5",
    "pg-boss": "^12.33.0",
    "pmtiles": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
