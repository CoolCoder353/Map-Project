{
  "name": "@wayfinder/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@wayfinder/shared": "workspace:*",
    "h3-js": "^4.5.0",
    "jose": "^6.2.12",
    "opening_hours": "3.14.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "*",
    "@types/pg": "^8.15.0"
  }
}
