{
  "name": "@wayfinder/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "development": "./src/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./copy": {
      "development": "./src/copy.ts",
      "types": "./dist/copy.d.ts",
      "default": "./dist/copy.js"
    },
    "./geo": {
      "development": "./src/geo.ts",
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./constants": {
      "development": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./australia": {
      "development": "./src/australia.ts",
      "types": "./dist/australia.d.ts",
      "default": "./dist/australia.js"
    },
    "./road-facts": {
      "development": "./src/road-facts.ts",
      "types": "./dist/road-facts.d.ts",
      "default": "./dist/road-facts.js"
    },
    "./light-timing": {
      "development": "./src/light-timing.ts",
      "types": "./dist/light-timing.d.ts",
      "default": "./dist/light-timing.js"
    },
    "./maneuvers": {
      "development": "./src/maneuvers.ts",
      "types": "./dist/maneuvers.d.ts",
      "default": "./dist/maneuvers.js"
    },
    "./lanes": {
      "development": "./src/lanes.ts",
      "types": "./dist/lanes.d.ts",
      "default": "./dist/lanes.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "h3-js": "^4.5.0",
    "zod": "^4.6.5"
  }
}
